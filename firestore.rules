rules_version = '2';

// ===================================a=========================================
// SECURITY MODEL SUMMARY
// ----------------------------------------------------------------------------
// Most write operations in this app go through the Nitro server API using
// the Firebase Admin SDK, which bypasses these rules entirely by design
// (pricing, availability, rental status, admin CRUD). These rules exist to
// govern what the CLIENT SDK can do directly: auth, low-stakes cart/
// favorites writes, and read access to public catalog data. Anything
// sensitive is denied here even though the server never needs these rules
// to act, specifically so a compromised or malicious client can never reach
// those collections directly.
// ============================================================================

service cloud.firestore {

  match /databases/{database}/documents {

    // ---- helper functions (must live INSIDE the match block so $(database) is in scope) --------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role is read from the user's own `users` document, NOT from custom claims,
    // so it always reflects the current, server-controlled value.
    function currentRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return currentRole() == 'admin' || currentRole() == 'staff';
    }

    // Matches the server (requireAuth): only 'disabled' accounts are blocked.
    // A users doc with a missing `status` field is treated as active.
    function isActiveAccount() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'disabled';
    }

    // ---- users -------------------------------------------------------------
    // A user may read/update their own displayName/phone, never their own
    // role or status (privilege escalation / self-reactivation prevention).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false; // only created server-side (see server/api/auth/register.post.ts)
      allow update: if isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'updatedAt']));
      allow delete: if false;
    }

    // ---- customers ---------------------------------------------------------
    // Customer can edit their own profile fields but never their own stats
    // or admin notes.
    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if false; // server-created on registration
      allow update: if isAdmin() ||
        (isOwner(customerId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['firstName', 'lastName', 'phone', 'addresses', 'updatedAt']));
      allow delete: if false;
    }

    // ---- catalog (public read, admin-only write) ---------------------------
    match /categories/{id} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if false; // admin writes go through the Nitro API
    }
    match /subcategories/{id} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if false;
    }
    match /products/{id} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if false; // pricing/inventory integrity requires server-side logic
    }
    match /productVariants/{id} {
      allow read: if isAdmin() ||
        get(/databases/$(database)/documents/products/$(resource.data.productId)).data.status == 'active';
      allow write: if false;
    }
    match /inventory/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- rentals & rentalItems (server-only, no direct client writes) ------
    match /rentals/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false; // all writes via server/api/rentals
    }
    match /rentalItems/{id} {
      allow read: if isAdmin() ||
        (isSignedIn() &&
          get(/databases/$(database)/documents/rentals/$(resource.data.rentalId)).data.customerId == request.auth.uid);
      allow write: if false;
    }

    // ---- cart (low-stakes, direct client writes allowed) -------------------
    match /cart/{customerId} {
      allow read, write: if isOwner(customerId) && isActiveAccount();
    }

    // ---- favorites (low-stakes, direct client writes allowed) --------------
    match /favorites/{customerId} {
      allow read, write: if isOwner(customerId) && isActiveAccount();
    }

    // ---- orders & payments (financial records, server-only) ----------------
    match /orders/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /payments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- coupons (never publicly readable, validated server-side only) -----
    match /coupons/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- settings (public read, server write) ------------------------------
    match /settings/{id} {
      allow read: if true;
      allow write: if false; // includes rentalCounter-* docs, which only the server increments
    }

    // ---- popups (server-only: served through /api/popup) -------------------
    match /popups/{id} {
      allow read, write: if false;
    }

    // ---- banners (public read of active, admin write) ----------------------
    match /banners/{id} {
      allow read: if resource.data.status == 'active' || isAdmin();
      allow write: if false;
    }

    // ---- notifications (per-user, server-created) --------------------------
    match /notifications/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ---- activityLogs (tamper-evidence, admin read-only) -------------------
    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}

