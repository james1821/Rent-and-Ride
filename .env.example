# ============================================================================
# SERVER-ONLY — Firebase Admin SDK credentials.
# NEVER prefix these with NUXT_PUBLIC_. NEVER expose them to the client.
# Get these from Firebase Console > Project Settings > Service Accounts >
# Generate new private key.
# ============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the \n escape sequences literal — the app converts them to real newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================================================
# PUBLIC — Firebase Web SDK config. Safe to expose to the browser; Firebase
# access is still governed by Firestore security rules, not secrecy
# of this config. Get these from Firebase Console > Project Settings > General
# > Your apps > SDK setup and configuration.
# ============================================================================
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================================
# PUBLIC — Branding. Shown in the header, footer, page title and emails.
# ============================================================================
NUXT_PUBLIC_SITE_NAME=RentRide

# ============================================================================
# SERVER-ONLY — Directory for admin-uploaded images (served at /uploads/*).
# Must be persistent storage in production (a mounted volume, not an ephemeral
# serverless filesystem). Defaults to ./uploads.
# ============================================================================
UPLOAD_DIR=./uploads
